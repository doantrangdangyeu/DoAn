// CAU H: IN CHI TIET CAC CAU HOI DA THI CUA 1 SINH VIEN, 1 MON HOC
// ===================================================================
void inChiTietCauHoiDaThi(treeMH &dsmh, DsLOP &dslop) {
    cout << "\n===== IN CHI TIET CAU HOI DA THI =====\n";
    string maSV, mamh;
    cout << "Nhap Ma SV: "; cin >> maSV;
    cout << "Nhap Ma Mon: "; cin >> mamh;

    PTRSINHVIEN sv = timKiemSV(dslop, maSV);
    if (sv == NULL) {
        cout << "Khong tim thay sinh vien '" << maSV << "'!\n";
        return;
    }

    PTRDIEMTHI d = sv->data.Diem;
    while (d != NULL && d->data.MAMH != mamh) d = d->Next;

    if (d == NULL) {
        cout << "Sinh vien " << maSV << " chua thi mon " << mamh << " (Chua thi).\n";
        return;
    }

    treeMH mon = timMonHoc(dsmh, mamh);
    if (mon == NULL) {
        cout << "Khong tim thay mon hoc (du lieu bi loi)!\n";
        return;
    }

    cout << "\nKet qua thi mon " << mamh << " cua SV " << maSV
         << " (" << sv->data.HO << " " << sv->data.TEN << "): "
         << d->data.Diem << " / 10\n";
    cout << "----- Chi tiet cau tra loi -----\n";

    PTRCTBT p = d->data.dsCTBT;
    int stt = 1;
    while (p != NULL) {
        Node_CAUHOI* ch = mon->data.dsCHT;
        while (ch != NULL && ch->data.id != p->data.id) ch = ch->next;

        cout << "\nCau " << stt++ << " (Id = " << p->data.id << "): ";
        if (ch != NULL) {
            cout << ch->data.NoiDung << "\n";
            cout << "  A. " << ch->data.a << "\n";
            cout << "  B. " << ch->data.b << "\n";
            cout << "  C. " << ch->data.c << "\n";
            cout << "  D. " << ch->data.d << "\n";
            cout << "  Dap an dung: " << ch->data.DapAn
                 << " | SV chon: " << p->data.chonluaSV
                 << (ch->data.DapAn == p->data.chonluaSV ? "  -> DUNG" : "  -> SAI") << "\n";
        } else {
            cout << "(Khong tim thay noi dung cau hoi goc trong du lieu hien tai)\n";
        }
        p = p->next;
    }
}

