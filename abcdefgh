// ===================================================================
// CAU F: NHAP CAU HOI THI (Id tu tang, duy nhat tren TAT CA cac mon)
// ===================================================================
void themCauHoiVaoMon(PTRCAUHOI &dsCHT, CAUHOI ch) {
    Node_CAUHOI* node = new Node_CAUHOI();
    node->data = ch;
    node->next = dsCHT; // them vao dau danh sach lien ket
    dsCHT = node;
}

char nhapKyTuDapAn(string thongBao) {
    char dapAn;
    do {
        cout << thongBao;
        cin >> dapAn;
        dapAn = toupper(dapAn);
    } while (dapAn != 'A' && dapAn != 'B' && dapAn != 'C' && dapAn != 'D');
    return dapAn;
}

void nhapCauHoi(treeMH &dsmh) {
    cout << "\n===== NHAP CAU HOI THI =====\n";
    if (dsmh == NULL) {
        cout << "Chua co mon hoc nao, vui long nhap mon hoc truoc!\n";
        return;
    }
    string mamh;
    cout << "Nhap Ma Mon Hoc can them cau hoi: ";
    cin >> mamh;

    treeMH mon = timMonHoc(dsmh, mamh);
    if (mon == NULL) {
        cout << "Khong tim thay mon hoc '" << mamh << "'!\n";
        return;
    }

    cout << "Them cau hoi cho mon " << mon->data.MAMH
         << " - " << mon->data.TENMH << "\n";

    while (true) {
        cout << "\nNhap Noi Dung Cau Hoi (Nhap '0' de dung): ";
        cin.ignore();
        string noiDung;
        getline(cin, noiDung);
        if (noiDung == "0") break;

        CAUHOI ch;
        ch.NoiDung = noiDung;
        cout << "Dap an A: "; getline(cin, ch.a);
        cout << "Dap an B: "; getline(cin, ch.b);
        cout << "Dap an C: "; getline(cin, ch.c);
        cout << "Dap an D: "; getline(cin, ch.d);
        ch.DapAn = nhapKyTuDapAn("Dap an dung (A/B/C/D): ");

        soCauHoiDaTao++;      // Id tu dong tang, dung chung cho tat ca mon
        ch.id = soCauHoiDaTao;

        themCauHoiVaoMon(mon->data.dsCHT, ch);
        cout << "Them cau hoi thanh cong! (Id = " << ch.id << ")\n";
    }
}

// ===================================================================
// CAU G: THI TRAC NGHIEM
// ===================================================================
int demSoCauHoi(PTRCAUHOI ds) {
    int dem = 0;
    while (ds != NULL) { dem++; ds = ds->next; }
    return dem;
}

void layMangCauHoi(PTRCAUHOI ds, Node_CAUHOI* mang[], int &n) {
    n = 0;
    while (ds != NULL && n < MAX_CAU_THI) {
        mang[n++] = ds;
        ds = ds->next;
    }
}

void xaoTron(Node_CAUHOI* mang[], int n) {
    for (int i = n - 1; i > 0; i--) {
        int j = rand() % (i + 1);
        Node_CAUHOI* tmp = mang[i];
        mang[i] = mang[j];
        mang[j] = tmp;
    }
}

void thiTracNghiem(treeMH &dsmh, DsLOP &dslop, string maSV) {
    cout << "\n===== THI TRAC NGHIEM =====\n";
    string mamh;
    cout << "Nhap Ma Mon thi: ";
    cin >> mamh;

    treeMH mon = timMonHoc(dsmh, mamh);
    if (mon == NULL) {
        cout << "Khong tim thay mon hoc '" << mamh << "'!\n";
        return;
    }

    int tongSoCau = demSoCauHoi(mon->data.dsCHT);
    if (tongSoCau == 0) {
        cout << "Mon hoc nay chua co cau hoi!\n";
        return;
    }
    cout << "Mon " << mon->data.TENMH << " co " << tongSoCau << " cau hoi.\n";

    int soCauThi;
    cout << "Nhap so cau hoi muon thi: ";
    cin >> soCauThi;
    if (soCauThi <= 0 || soCauThi > tongSoCau) {
        cout << "So cau khong hop le!\n";
        return;
    }

    int soPhut;
    cout << "Nhap so phut lam bai: ";
    cin >> soPhut;

    Node_CAUHOI* mangCH[MAX_CAU_THI];
    int n = 0;
    layMangCauHoi(mon->data.dsCHT, mangCH, n);
    srand((unsigned)time(0));
    xaoTron(mangCH, n);

    PTRCTBT dsTraLoi = NULL;
    int soCauDaLam = 0, soCauDung = 0;
    time_t batDau = time(0);

    cout << "\nBat dau lam bai! Ban co " << soPhut << " phut.\n";

    for (int i = 0; i < soCauThi; i++) {
        double phutTroi = difftime(time(0), batDau) / 60.0;
        if (phutTroi >= soPhut) {
            cout << "\n*** Da het gio lam bai! ***\n";
            break;
        }

        CAUHOI &ch = mangCH[i]->data;
        cout << "\nCau " << i + 1 << ": " << ch.NoiDung << "\n";
        cout << "  A. " << ch.a << "\n";
        cout << "  B. " << ch.b << "\n";
        cout << "  C. " << ch.c << "\n";
        cout << "  D. " << ch.d << "\n";

        char traLoi = nhapKyTuDapAn("Chon dap an (A/B/C/D): ");
        soCauDaLam++;

        NodeCHT_SV* node = new NodeCHT_SV();
        node->data.id = ch.id;
        node->data.chonluaSV = traLoi;
        node->next = dsTraLoi;
        dsTraLoi = node;

        if (traLoi == ch.DapAn) soCauDung++;
    }

    float diem = (soCauThi > 0) ? (soCauDung * 10.0f / soCauThi) : 0;
    cout << "\nDa lam " << soCauDaLam << "/" << soCauThi << " cau, dung " << soCauDung << " cau.\n";
    cout << "Diem: " << diem << " / 10\n";

    PTRSINHVIEN sv = timKiemSV(dslop, maSV);
    if (sv == NULL) {
        cout << "Khong tim thay ho so sinh vien, khong the luu diem!\n";
        return;
    }

    NodeDIEMTHI* diemMoi = new NodeDIEMTHI();
    diemMoi->data.MAMH = mamh;
    diemMoi->data.Diem = diem;
    diemMoi->data.dsCTBT = dsTraLoi;
    diemMoi->Next = sv->data.Diem; // them vao dau danh sach diem cua SV
    sv->data.Diem = diemMoi;

    cout << "Da luu ket qua thi vao ho so sinh vien " << maSV << ".\n";
}

